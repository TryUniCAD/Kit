  "rules": {
    "confirmed": [
      "API GetPosition copies exactly three native coordinates",
      "ordinary non-dimension branch obtains note text position through virtual+0x3b0",
      "note setter constructs requested minus current point translation",
      "note text store computes requested minus actual attachment and transforms that vector into the note frame",
      "conditional planar predicate zeroes local vector Z before normalized direction and distance are stored",
      "note getter reconstructs text from actual attachment plus its in-plane vector/distance"
    ],
    "partial": [
      "actual attachment-to-view projection chain and actual planar-mode value on the new note need independent native checks",
      "constant-cap projection under the exact Front unit-scale view predicts a fixed note depth; no generic rotated-note rule is claimed"
    ],
    "refuted": [
      "drawing annotation request z0 necessarily returns z0",
      "the observed .0035 implies a view scale of .5"
    ]
  },
