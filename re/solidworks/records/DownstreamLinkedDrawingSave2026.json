    },
    {
      "owner": "cap/side representation",
      "rule": "forced conversion reaches slot100; actual ordinary nonnull filed model differs from NULL target, so subtype clone slot280 and keeper_context(NULL,1) run; null/foreign feature branches remain conditional",
      "source": "0x4bac8330; cap table0x4cf705a8; side table0x4cf6ab10"
    },
    {
      "owner": "embedded FR keeper",
      "rule": "nonnull cached feature reaches actual filed owner, creates/retargets persistent FR then clears cached feature; absent cached feature plus persistent FR can consult separate global0x4db608b0 and re-share owner",
      "source": "0x4bb5d4a0; 0x4bb5d5d3; 0x4bb5d5e5; 0x4bb5d5ea; 0x4bb5d4f8; 0x4bb35b20"
    },
    {
      "owner": "drawing native store",
      "rule": "per-row setLocalFeatureToNULL conditional normalization is separate from copying/externalizing and from raw wire replay; persistent FR remains retained by that chain",
      "source": "0x4c95d803; 0x4c95d80e; dependency DrawingDetailingIndexRead2026.json"
    }
