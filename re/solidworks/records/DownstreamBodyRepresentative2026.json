{
  "atom_history": {
    "algorithm": "getBaseAtom first appends the starting actual atom to supplied collection, then follows supported feature atom-list relations, recording each visited atom; native cycle protection is feature-pointer based",
    "limits": "Multiple outputs, earlier input atoms and alternate-feature paths must follow actual graph and are not represented by a universal single-id default",
    "single_boss": "Actual starting atom has real producing boss; its f530 atom list empty so traversal stops at that atom, backing_ids=[actual_body_atom_id] and base feature is that same boss",
    "stored_ids": "Extract each collected atom.f140 in actual collection order and assign backing UIntArray; never substitute feature ids, row numbers or kernel tags"
  },
  "confidence": {
    "native_qualification": "not found",
    "reason": "Original ranges/dispatch and data flow verified; no complete-path dynamic trace or generated native cache trial in this tranche",
    "source_field_rules": "partial"
  },
  "creation": {
    "actual_body": "Resolve supplied atom via actual model.fd88 getAtomFromId, then atom.f160; standalone unit+1e8 false skips component body re-enumeration",
    "constructor": "0x4b7e8980 receives actual self component, actual body atom id, faceNULL, bodyNULL; final native in-charge parameter1 is not a wire option",
    "gate": "Actual part+1a0 true; option global0x4db5681c bit0x10; nonempty retained f690 body inventory; part+1a8 false; actual body.isSolid(0,gcPointerKnow0)",
    "option_authority": "Runtime option word is an explicit predicate; its actual process value and setting policy are not observed or generated here",
    "order": "After face/edge creation, optional vertex construction and late EdgeRef repair; same shared data.f08 allocation sequence",
    "wrapper_atom_words": "Constructor copies supplied actual atom id into inherited f18/f1c; these are not the downstream allocated row number"
  },
