  "rules": {
    "fresh_growth": "Compare binary32 prospective_count/bucket_count to max_load; when exceeded, choose ceil(prospective_count/max_load), at least 8; if old bucket count <512 and old*8 meets the minimum choose old*8; rehash rounds the requested count to a power of two",
    "fresh_prism12": "Keys 7..14 fill distinct old buckets; before key 15 links, count 9 requires growth 8->64; retained/new keys have distinct final buckets; no rehash collision splice or final occupied-bucket insertion is reached",
    "initial_state": "Each separately constructed table has its own global list sentinel, zero count, 8 buckets, mask 7, binary32 maximum load 1",
    "key_hash": "64-bit FNV-1a over exactly four little-endian key bytes, zero-extended individually; integer equality compares all 32 key bits",
    "scope": "Numeric helper admits at most12 unique nonzero wire keys and refuses any actual occupied-bucket insertion or rehash collision; duplicate/update, general collision order, other STL releases, native cache acceptance and all endpoint/body identities remain outside this tranche",
    "separate_loaded_state": "The native read branch clears and reserves from the incoming table count before reconstruction. With count12 and max_load1 its leaf requests12 and rehash rounds to16, unlike fresh incremental growth to64. This is distinct from the fresh model covered here",
    "store_order": "Follow sentinel.next through node.next; no bucket-number walk, signed sort or geometric sort. f380 count and keys use signed 32-bit native long primitive; f340 uses unsigned key primitive",
    "table_selection": "type 0x138c -> f340; type 0x138a -> f380; both call insertion 0x4b51a800"
  },
