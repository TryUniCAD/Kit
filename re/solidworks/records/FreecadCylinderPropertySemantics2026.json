  "rules": {
    "geometric_parameter_paths": [
      "Radius",
      "Height",
      "Angle",
      "FirstAngle",
      "SecondAngle"
    ],
    "displacement_formula": "d=(Height*tan(radians(FirstAngle)), Height*tan(radians(SecondAngle)), Height)",
    "directional_length_formula": "L=Height*sqrt(1+tan(radians(FirstAngle))^2+tan(radians(SecondAngle))^2)",
    "nonzero_angle_inference": "The circle/sector stays in the original base plane and is translated by d; a rigidly tilted right cylinder is generally not equivalent",
    "angle_constraint": {
      "declared_min_degrees": 0,
      "declared_max_degrees": 360,
      "step_degrees": 1,
      "execute_rejects_below": "Precision::Confusion()",
      "confidence": "partial"
    },
    "prism_angle_constraints": {
      "declared_min_degrees": -89.99999,
      "declared_max_degrees": 89.99999,
      "step_degrees": 1,
      "confidence": "partial"
    },
    "cylinder_execute_checks": {
      "Radius": "rejects below Precision::Confusion()",
      "Height": "rejects below Precision::Confusion()",
      "Angle": "rejects below Precision::Confusion()"
    },
    "attacher_engine_classes": {
      "Engine 3D": "Attacher::AttachEngine3D",
      "Engine Plane": "Attacher::AttachEnginePlane",
      "Engine Line": "Attacher::AttachEngineLine",
      "Engine Point": "Attacher::AttachEnginePoint"
    },
    "deactivated_map_mode": 0,
    "map_path_single_curve_formula": "u=curve_first_parameter+MapPathParameter*(curve_last_parameter-curve_first_parameter)",
    "output_status_meaning": "Suppresses geometry touch; it does not imply a computed value, absence, non-persistence or immutability",
    "hidden_status_meaning": "Editor visibility; it does not imply a cache or disposable data"
  },
