  "source_rule": {
    "array_count_and_fill_use_same_walk": true,
    "body_shell_head_is_not_the_region_iteration_head": true,
    "edge_order": [
      "walk BODY.edge through EDGE.next",
      "walk BODY.region through REGION.next",
      "for each region walk REGION.shell through SHELL.next",
      "for each shell append SHELL.edge through EDGE.next"
    ],
    "face_order": [
      "walk BODY.region through REGION.next",
      "for each region walk REGION.shell through SHELL.next",
      "for each shell append SHELL.face through FACE.next"
    ],
    "first_edge_and_face_use_same_walk": true,
    "front_face_chain_is_not_appended": true,
    "head_and_link_initial_construction_order_not_derived_here": true,
